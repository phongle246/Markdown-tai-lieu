{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "textbook2md",
  "version": "0.1.0",
  "identifier": "org.textbook2md.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../app run build",
    "beforeDevCommand": "npm --prefix ../app run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../app/dist": "dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}